{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anusha-dagar-portfolio",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-26",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "404-page"
  },
  "ai": {
    "binding": "AI"
  }
}
